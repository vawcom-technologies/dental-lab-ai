# Copy to mobile/.env.production (gitignored).
# App Store / TestFlight builds MUST use a public HTTPS API.
# Localhost and http:// LAN URLs will be rejected or fail on device.
#
#   cp .env.production.example .env.production
#   flutter build ipa --release --dart-define-from-file=.env.production \
#     --export-options-plist=ios/ExportOptions.plist

API_BASE=https://api.example.com
