# Copy to mobile/.env (gitignored). No trailing slash on URLs.
#
# Optional override (IDE launch.json already passes this):
#   flutter run --dart-define-from-file=.env
#
# Physical iPad debug builds also auto-use this Mac's Bonjour host
# (Mishis-MacBook-Pro.local) when API_BASE is unset — see resolveApiBase().

# Same machine (Chrome, Windows desktop, iOS simulator on Mac)
API_BASE=http://127.0.0.1:8000

# Physical iPad / phone override (optional if Bonjour works):
# API_BASE=http://192.168.1.48:8000
