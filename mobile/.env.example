# Copy to mobile/.env (gitignored). No trailing slash on URLs.
#
# Used as Flutter dart-defines:
#   flutter run --dart-define-from-file=.env
# Cursor / VS Code launch.json already passes that flag.

# Same machine (Chrome, Windows desktop, iOS simulator on Mac)
API_BASE=http://127.0.0.1:8000

# Physical iPad / phone: 127.0.0.1 is the device itself.
# Start the API with --host 0.0.0.0 and use this PC's LAN IP instead, e.g.
# API_BASE=http://192.168.0.177:8000
