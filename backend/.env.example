# Copy to backend/.env and fill in. Never commit real keys.
# Loaded by app/core/config.py (pydantic-settings). Run uvicorn from backend/.

APP_NAME=Dental Lab AI

# --- Supabase ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Where the password-reset email link sends the user (public web page)
PASSWORD_RESET_REDIRECT_URL=https://example.com/forgot-password/

# --- Resend (transactional email from elite-d.de) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=Elite Dental Support <support@elite-d.de>
RESEND_WELCOME_TO_EMAIL=support@elite-d.de

# --- Cloudflare R2 (S3-compatible) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Chat voice notes
R2_VOICE_BUCKET=
R2_VOICE_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# Chat documents
R2_DOCUMENTS_BUCKET=
R2_DOCUMENTS_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# Chat videos (original quality, max 200 MB)
R2_VIDEOS_BUCKET=
R2_VIDEOS_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# Chairside patient camera photos
R2_PATIENT_IMAGES_BUCKET=
R2_PATIENT_IMAGES_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# Patient clinical media
R2_SCANS_BUCKET=
R2_SCANS_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
R2_SHADES_BUCKET=
R2_SHADES_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
R2_SMILES_BUCKET=
R2_SMILES_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# Fernet key material for encrypted patient notes (long random secret)
PATIENT_NOTES_ENCRYPTION_KEY=

# --- Shade segmentation (KAIST is the primary path) ---
# Default in code is kaist. Classical only if KAIST cannot run (missing
# vendor/weights) or crashes — not when KAIST finds 0 teeth.
SHADE_SEGMENT_BACKEND=kaist
SHADE_SEGMENT_KAIST_WEIGHTS=weights/kaist/CP_teeth_seg.pth
SHADE_SEGMENT_KAIST_VENDOR=vendor/individual_tooth_segmentation
SHADE_SEGMENT_KAIST_DEVICE=auto
# Chairside speed+accuracy (clamp work canvas; labels mapped back):
SHADE_SEGMENT_KAIST_MAX_SIDE=320
SHADE_SEGMENT_KAIST_MIN_SIDE=256
SHADE_SEGMENT_KAIST_SNAKE_ITERS=10
SHADE_SEGMENT_KAIST_BRING_BACK_ITERS=60
SHADE_SEGMENT_KAIST_EVOLVE_ITERS=30
SHADE_SEGMENT_KAIST_RESIZE=false
# Do not set MAX_SIDE=0 — full-res snakes miss the iPad 90s timeout.
# Setup: python scripts/run_kaist_pilot.py --setup && --download-weights
#        pip install -r requirements-kaist.txt
#
# Emergency only: force classical heuristics
# SHADE_SEGMENT_BACKEND=classical
#
# Legacy: RF-DETR / PLAK via Roboflow Inference (plaque semantic — not recommended)
# ROBOFLOW_API_KEY=your_key
# SHADE_SEGMENT_BACKEND=rfdetr
# SHADE_SEGMENT_ROBOFLOW_MODEL_ID=mahvish-hasan/plak---projectdens-7p9sm-atp73-1-yolo26s-sem-t1
# SHADE_SEGMENT_INFERENCE_API_URL=https://serverless.roboflow.com
# SHADE_SEGMENT_CONF=0.25
